# Authentik VPS Environment Variables
# Copy to .env and configure

# PostgreSQL credentials
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=changeme_use_strong_password
AUTHENTIK_POSTGRES_DB=authentik

# Authentik secret key (generate with: openssl rand -hex 50)
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand_hex_50
