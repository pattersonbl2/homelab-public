# Stock Assistant Configuration

# Ollama model to use (must be pulled in Ollama first)
# Recommended: llama3.1:8b, mistral, or phi3
STOCK_OLLAMA_MODEL=llama3.1:8b

# Optional: Alpha Vantage API key for additional market data
# Free tier: 25 requests/day - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Optional: Finnhub API key for news
# Free tier: 60 calls/min - https://finnhub.io/register
FINNHUB_API_KEY=
