# Stack Environment Variables
# Copy this file to 'env' and fill in your values

# ── Networking / DNS ─────────────────────────────────────────────────────────

# Domain for Traefik routing (local subdomain for home network)
# Example: local.yourdomain.com -> traefik.local.yourdomain.com
DOMAIN=local.yourdomain.com

# Cloudflare - for Traefik Let's Encrypt DNS challenge
CLOUDFLARE_DNS_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMAIL=your_cloudflare_email_here

# Pi-hole admin password (networking stack)
WEBPASSWORD=your_pihole_password_here

# ── Core / Traefik ────────────────────────────────────────────────────────────

# Proxmox host IPs (used in Traefik dynamic config for dashboard routing)
PROXMOX_PVE_IP=192.168.x.x
PROXMOX_PVE2_IP=192.168.x.x

# Pi-hole host (used in Traefik dynamic config)
PIHOLE_HOST=192.168.x.x

# Traefik dashboard secret (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# ── Database (database stack) ─────────────────────────────────────────────────

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ── Media (media stack) ───────────────────────────────────────────────────────

# Gluetun VPN - ProtonVPN WireGuard private key
P_KEY=your_wireguard_private_key_here

# Speedtest Tracker
# Generate with: echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=base64:your_key_here

# ── Gitea (gitea stack) ───────────────────────────────────────────────────────

GITEA_DB_PASSWORD=your_gitea_db_password_here
# Generate runner token from Gitea Site Admin > Runners after first boot
GITEA_RUNNER_TOKEN=your_runner_registration_token_here
# gitea-lxc /root/.env additionally needs GITEA_DB_PASS (deployed var name) and
# RESTIC_PASSWORD (same value as the dockerhost backup stack) for gitea-backup

# ── Breakglass deploy/fix capability (services/breakglass) ────────────────────
# Scoped to mono-homelab repo write+PR only — not org/admin-wide.
BREAKGLASS_GITEA_TOKEN=your_scoped_gitea_token_here
# Separate from the brain-agent's CLAUDE_CODE_OAUTH_TOKEN, for auditability.
BREAKGLASS_CLAUDE_TOKEN=your_claude_code_oauth_token_here
# R2 backend creds for terraform_plan's `terraform init` (read access to the
# homelab-tfstate bucket is enough — terraform_plan never applies). No
# terraform project is currently allow-listed (see
# services/breakglass/deploy/allowlist.yaml); these are ready for whenever
# one is wired up.
BREAKGLASS_TF_R2_ACCOUNT_ID=your_cloudflare_account_id_here
BREAKGLASS_TF_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
BREAKGLASS_TF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# ── Vikunja (projects stack) ──────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
VIKUNJA_SERVICE_JWTSECRET=your_vikunja_jwt_secret_here
VIKUNJA_DB_PASSWORD=your_vikunja_db_password_here

# ── Monitoring (core stack) ───────────────────────────────────────────────────

# Proxmox exporter config — create stacks/core/pve.yml from stacks/core/pve.yml.example
# (no env vars needed; credentials live in pve.yml which is gitignored)

# ── Pangolin / Newt tunnel (newt stack) ───────────────────────────────────────

# Pangolin server endpoint (your VPS)
PANGOLIN_ENDPOINT=https://pangolin.yourdomain.com
# Newt site credentials (from Pangolin dashboard > Sites)
NEWT_ID=your_newt_site_id_here
NEWT_SECRET=your_newt_site_secret_here

# ── Authentik (authentik-vps stack) ───────────────────────────────────────────

# Note: These are only needed if deploying Authentik to homelab.
# For VPS deployment, credentials are auto-generated by deploy-pangolin.yml.
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=your_authentik_db_password_here
AUTHENTIK_POSTGRES_DB=authentik
# Generate with: openssl rand -hex 50
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here

# ── Wazuh (wazuh stack) ────────────────────────────────────────────────────

# Wazuh indexer admin password (used by manager and dashboard to connect to indexer)
WAZUH_INDEXER_PASSWORD=your_indexer_password_here
# Wazuh dashboard kibanaserver password
WAZUH_DASHBOARD_PASSWORD=your_dashboard_password_here
# Wazuh API credentials (used by dashboard to connect to manager API)
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=your_wazuh_api_password_here
